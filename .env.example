# Copy file này thành .env rồi điền giá trị. KHÔNG đưa file .env lên GitHub.

# Bắt buộc để AI viết bài (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Khuyên dùng: giá spot chuẩn cho XAUUSD/EURUSD/GBPUSD (miễn phí tại https://twelvedata.com)
TWELVEDATA_API_KEY=

# Dùng khi bật chức năng đăng bài (bước sau)
FB_PAGE_ID=
FB_PAGE_TOKEN=
