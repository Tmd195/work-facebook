# Copy file này thành .env rồi điền giá trị. KHÔNG đưa file .env lên GitHub.
# Công cụ kiểm tra / đổi token (không in token ra màn hình): python -m src.setup_tokens

# Telegram: token bot từ @BotFather; CHAT_ID để trống - công cụ tự lấy sau khi anh nhắn bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude Code gói Pro: lệnh `claude setup-token` (chuỗi sk-ant-oat...)
CLAUDE_CODE_OAUTH_TOKEN=

# Facebook: App ID/Secret (Cài đặt ứng dụng > Thông tin cơ bản), user token tạm từ Graph API Explorer
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
# Công cụ tự điền:
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Twelve Data (không bắt buộc): giá spot
TWELVEDATA_API_KEY=

# Chỉ khi chuyển sang API trả phí (config.yaml ai.backend: api)
ANTHROPIC_API_KEY=
